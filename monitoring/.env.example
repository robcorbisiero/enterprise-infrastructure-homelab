# Copy to monitoring/.env and set a real password before running `docker compose up -d`.
# Compose refuses to start Grafana if GRAFANA_ADMIN_PASSWORD is unset, so the
# initial admin password must be chosen explicitly. Existing Grafana passwords
# must be changed in Grafana; this variable does not reset an existing database.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
